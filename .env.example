# Binance Trading Bot - Environment Variables
# Copy this file to .env and update with your actual credentials
# Docker Compose will automatically use the .env file in the root directory

# REQUIRED: Replace with your actual Binance API credentials
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=REPLACE_WITH_YOUR_BINANCE_API_KEY
BINANCE_API_SECRET=REPLACE_WITH_YOUR_BINANCE_API_SECRET

# Optional: Server configuration
PORT=3001
NODE_ENV=development
